<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/txtWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome!"
            android:textColor="#202124"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtShopName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Your Shop"
            android:textColor="#757575"
            android:textSize="15sp" />

        <!-- Total Balance Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#E4F4E8"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Lena Hai / Jama"
                android:textColor="#444444"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtTotalBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Lena: ₹ 0.00"
                android:textColor="#18763B"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Today's Udhar Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFF0DE"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aaj Ka Udhar"
                android:textColor="#555555"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtTodayCredit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Udhar: ₹ 0.00"
                android:textColor="#D66A00"
                android:textSize="27sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Customers Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Customers"
                android:textColor="#222222"
                android:textSize="21sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCustomers"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:text="+ Add Customer"
                android:textAllCaps="false"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Customer Search -->
        <EditText
            android:id="@+id/edtDashboardSearch"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@android:drawable/edit_text"
            android:hint="Search name or mobile number"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textSize="15sp" />

        <!-- Customer Count -->
        <TextView
            android:id="@+id/txtDashboardCustomerCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="0 Customers"
            android:textColor="#777777"
            android:textSize="13sp" />

        <!-- Dynamic Customer List -->
        <LinearLayout
            android:id="@+id/layoutDashboardCustomers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <!-- Logout -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="16dp"
            android:text="Logout"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
